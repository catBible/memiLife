# Copy to .env.local and fill in values.

# Server-only: backend base URL. Only the origin is used (scheme+host+port; paths like /api/v1 are ignored).
# e.g. http://localhost:8080  or  http://localhost:8080/api/v1
MEMI_BACKEND_URL=

# Optional: server-only key for Spring write APIs (POST/PATCH/DELETE). Proxied from Next route handlers when the browser request does not send X-API-Key.
MEMI_BACKEND_API_KEY=

