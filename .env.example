# Copy to .env.local and fill in values.

# Server-only: backend base URL. Only the origin is used (scheme+host+port; paths like /api/v1 are ignored).
# e.g. http://localhost:8080  or  http://localhost:8080/api/v1
MEMI_BACKEND_URL=

# Optional: public origin (browser / shared). If unset, dev defaults to 127.0.0.1:8080 for hints; proxy uses MEMI_BACKEND_URL or dev default.
NEXT_PUBLIC_API_URL=
